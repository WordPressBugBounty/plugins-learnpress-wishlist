{
  "name": "learnpress-addons/learnpress-assignment",
  "description": "Coding Standard for learnpress.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/LearnPress/learnpress",
  "authors": [
    {
      "name": "LearnPress team",
      "email": "learnpress@thimpress.com",
      "homepage": "https://thimpress.com"
    }
  ],
  "support": {
    "issues": "https://github.com/LearnPress/learnpress/issues"
  },
  "require": {
  },
  "require-dev": {
	"dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
	"squizlabs/php_codesniffer": "^3.13.6",
	"wp-coding-standards/wpcs": "^3.4.1",
	"phpcsstandards/phpcsutils": "^1.2.3",
	"phpunit/phpunit": "^10.5.64",
	"phpcompatibility/php-compatibility": "9.3.5",
	"brain/monkey": "^2.7.0",
	"mockery/mockery": "^1.6.14"
  },
  "scripts": {
	"format": "phpcbf --standard=phpcs.xml --report-summary --report-source",
	"lint": "phpcs --standard=phpcs.xml"
  },
  "autoload": {
    "psr-4": {
      "LearnPress\\Wishlist\\": "inc/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
